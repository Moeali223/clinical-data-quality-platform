# Only these project inputs enter the Docker build context.
**
!Dockerfile
!Dockerfile.db
!.dockerignore
!pyproject.toml
!requirements.txt
!README.md
!src/
!src/**
!tests/
!tests/**
!sql/
!sql/**
!data/
!data/**
!scripts/
!scripts/**

# Exclude generated files even inside allowed directories.
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.pytest_cache/
